/*Q39: Write a program to find the product of odd digits of a number./*
#include <stdio.h>

int main() {
    int num, digit, product = 1;

    scanf("%d", &num);

    while (num != 0) {
        digit = num % 10;

        if (digit % 2 != 0) {
            product = product * digit;
        }

        num = num / 10;
    }

    printf("%d", product);

    return 0;
}
/*Q40: Write a program to find the 1’s complement of a binary number and print it./*
#include <stdio.h>

int main() {
    char binary[100];
    int i;

    scanf("%s", binary);

    for (i = 0; binary[i] != '\0'; i++) {
        if (binary[i] == '0')
            binary[i] = '1';
        else if (binary[i] == '1')
            binary[i] = '0';
    }

    printf("%s", binary);

    return 0;
}
