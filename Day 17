/*Q33: Write a program to check if a number is an Armstrong number./*
#include <stdio.h>

int main() {
    int num, original, remainder, sum = 0;

    scanf("%d", &num);

    original = num;

    while (num != 0) {
        remainder = num % 10;
        sum = sum + (remainder * remainder * remainder);
        num = num / 10;
    }

    if (sum == original) {
        printf("Armstrong");
    } else {
        printf("Not Armstrong");
    }

    return 0;
}
/*Q34: Write a program to check if a number is prime./*
#include <stdio.h>

int main() {
    int n, i, flag = 0;

    scanf("%d", &n);

    if (n <= 1) {
        printf("Not prime");
    } else {
        for (i = 2; i < n; i++) {
            if (n % i == 0) {
                flag = 1;
                break;
            }
        }

        if (flag == 0)
            printf("Prime");
        else
            printf("Not prime");
    }

    return 0;
}
