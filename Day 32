/*Q63: Merge two arrays./*
#include <stdio.h>

int main() {
    int n1, n2, i;
    int arr1[100], arr2[100], merged[200];

    // Read first array
    scanf("%d", &n1);
    for (i = 0; i < n1; i++) {
        scanf("%d", &arr1[i]);
    }

    // Read second array
    scanf("%d", &n2);
    for (i = 0; i < n2; i++) {
        scanf("%d", &arr2[i]);
    }

    // Copy first array
    for (i = 0; i < n1; i++) {
        merged[i] = arr1[i];
    }

    // Copy second array
    for (i = 0; i < n2; i++) {
        merged[n1 + i] = arr2[i];
    }

    // Print merged array
    for (i = 0; i < n1 + n2; i++) {
        printf("%d ", merged[i]);
    }

    return 0;
}

/*Q64: Find the digit that occurs the most times in an integer number./*
#include <stdio.h>

int main() {
    long long n;
    int count[10] = {0};
    int digit, maxDigit = 0, i;

    scanf("%lld", &n);

    // Count frequency of each digit
    while (n > 0) {
        digit = n % 10;
        count[digit]++;
        n = n / 10;
    }

    // Find digit with highest frequency
    for (i = 1; i < 10; i++) {
        if (count[i] > count[maxDigit]) {
            maxDigit = i;
        }
    }

    printf("%d", maxDigit);

    return 0;
}
