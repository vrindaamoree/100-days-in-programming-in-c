/*Q55: Write a program to print all the prime numbers from 1 to n./*
#include <stdio.h>

int main() {
    int n, i, j, count;

    scanf("%d", &n);

    for (i = 2; i <= n; i++) {
        count = 0;

        for (j = 1; j <= i; j++) {
            if (i % j == 0) {
                count++;
            }
        }

        if (count == 2) {
            printf("%d ", i);
        }
    }

    return 0;
}
/*Q56: Read and print elements of a one-dimensional array./*
#include <stdio.h>

int main() {
    int n, i;
    int arr[100];

    scanf("%d", &n);

    // Read array elements
    for (i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    // Print array elements
    for (i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }

    return 0;
}
